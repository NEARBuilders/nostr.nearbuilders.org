{
  "extends": "bos://dev.everything.near/dev.everything.dev",
  "account": "nearbuilding.near",
  "domain": "nostr.nearbuilders.org",
  "title": "everything.dev",
  "description": "Open runtime for apps on NEAR, composed from published config and loaded through a shared host, UI, and API runtime.",
  "staging": {
    "domain": "dev.everything.dev"
  },
  "repository": "https://github.com/NEARBuilders/nostr.nearbuilders.org",
  "ci": {
    "railway": {
      "service": "app"
    }
  },
  "app": {
    "ui": {
      "development": "local:ui"
    },
    "api": {
      "development": "local:api",
      "secrets": [
        "API_DATABASE_URL"
      ],
      "connectSrc": ["wss://relay.damus.io", "wss://nos.lol", "wss://relay.primal.net"]
    }
  },
  "plugins": {
    "nostr": {
      "development": "local:nostr",
      "secrets": [
        "NOSTR_DATABASE_URL"
      ],
      "connectSrc": ["wss://relay.damus.io", "wss://nos.lol", "wss://relay.primal.net"]
    }
  }
}
